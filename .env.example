# ==============================================================================
# AI Labs Environment Variables Configuration
# Copy this file to .env and provide your corresponding credentials.
# ==============================================================================

# LLM Provider Configuration (options: openai, anthropic, google, mock)
LLM_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini
TEMPERATURE=0.2

# OpenAI API Key (Required for default pipeline execution)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Optional: Alternative Providers
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_API_KEY=your-gemini-api-key
HUGGINGFACEHUB_API_TOKEN=your-hf-token

# Search Engine API (Used in Deep Research Module 07)
# Get a free key at https://tavily.com
TAVILY_API_KEY=tvly-your-tavily-api-key

# Storage & Database Paths
SQLITE_DB_PATH=data/enterprise_demo.db
CHROMA_PERSIST_DIR=data/chroma_db

# Development & Offline Mode
# Set to 'true' to run all pipelines with built-in heuristic/synthetic responses
# if you do not have active API credentials.
MOCK_MODE=false
